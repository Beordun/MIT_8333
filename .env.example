# PostgreSQL connection string (Neon / Supabase / Local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secret key for signing JWT session cookies (use a long random string in .env)
JWT_SECRET="replace-with-a-secure-random-64-char-secret"

# Gmail SMTP settings for Nodemailer confirmation & OTP emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-gmail-app-password"
SMTP_FROM="MivaFix Service Desk <your-email@gmail.com>"
